{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peecare.example/schemas/development-beta-tester-inventory.json",
  "title": "PeeCare development beta tester inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "marker", "testers"],
  "properties": {
    "environment": { "const": "development" },
    "marker": { "const": "peecare-development-web-beta-v1" },
    "testers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "propertyNames": {
          "not": {
            "pattern": "email.*link|oob.*code|out.*of.*band|action.*code|password|credential|secret|token"
          }
        },
        "required": ["alias", "deviceId"],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$",
            "allOf": [
              {
                "not": {
                  "pattern": "email.*link|oob.*code|out.*of.*band|action.*code|password|passphrase|credential|secret|token|private.*key|service.*account|api.*key|firebase.*uid"
                }
              },
              {
                "not": {
                  "pattern": "^[A-Za-z0-9]{24,128}$"
                }
              }
            ]
          },
          "deviceId": {
            "type": "string",
            "pattern": "^PC-DEV-[0-9]{6}$"
          }
        }
      }
    }
  }
}
