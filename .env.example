# Local Firebase Emulator configuration for the fail-closed client adapter.
#
# Copy this file to .env.local to enable src/platform/firebase.
# All values below are non-secret demo defaults for the local Emulator Suite.
# NEVER put a real Firebase project ID, API key, or service account here.

# Explicitly select the local adapter. Cloud builds must set this to
# "development" and provide the separately approved public Firebase config.
VITE_FIREBASE_ENVIRONMENT=local

# Must be exactly "true" to allow the local Firebase adapter to initialize.
VITE_FIREBASE_USE_EMULATORS=true

# Must be exactly "demo-peecare"; any other value fails closed (project_mismatch).
VITE_FIREBASE_PROJECT_ID=demo-peecare

# Non-secret demo API key. The Auth Emulator ignores the real value.
VITE_FIREBASE_API_KEY=demo-api-key

# Auth Emulator must be reachable only on loopback 127.0.0.1:9099.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099

# Firestore Emulator must be reachable only on loopback 127.0.0.1:8085.
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8085

# Local independent Member API origin. Production builds require a non-loopback
# HTTPS origin and reject this local URL.
VITE_MEMBER_API_URL=http://127.0.0.1:8087
