rules_version = '2';

// Deny-by-default baseline for the local Firebase platform.
//
// No domain schema is authorized yet. Every read and write on every document
// path is denied for unauthenticated and authenticated clients alike. Each
// future domain change MUST replace this with an explicit, tested delta rather
// than loosening the baseline here.
//
// Rules-disabled test contexts (initializeTestEnvironment withSecurityRulesDisabled)
// may still arrange fixtures; that bypass is a test-harness capability, not a
// client authorization path.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
