{
  "steps": [
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "--platform",
        "linux/amd64",
        "--file",
        "services/ingestion-api/Dockerfile",
        "--tag",
        "${_IMAGE}",
        "."
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "run",
        "--rm",
        "${_IMAGE}",
        "node",
        "--input-type=module",
        "--eval",
        "import('@peecare/device-events-contract').then(({ loadValidators }) => loadValidators())"
      ]
    }
  ],
  "images": ["${_IMAGE}"]
}
