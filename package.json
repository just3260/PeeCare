{
  "name": "peecare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "check": "npm run type-check && npm run test:unit && npm run build && npm run check:member && npm run check:ingestion",
    "check:member": "npm --prefix services/member-api run check",
    "check:ingestion": "npm --prefix services/ingestion-api run check",
    "emulators:start": "firebase emulators:start --project demo-peecare",
    "emulators:reset": "node firebase/local/reset.mjs",
    "firebase:development:preflight": "node firebase/development/preflight.mjs",
    "firebase:development:deploy": "node firebase/development/deploy.mjs",
    "firebase:development:seed": "node firebase/development/seed.mjs",
    "firebase:development:verify": "node firebase/development/verify.mjs",
    "test:firebase": "node scripts/test-firebase.mjs",
    "check:all": "npm run check && npm run test:firebase",
    "check:release": "node scripts/check-release.mjs",
    "ci:workspaces": "node scripts/install-workspaces.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^13.35.1",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
